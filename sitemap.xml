---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for entry in site.pages %}
  {%- assign last = entry.url | slice: -1, 1 -%}
  {%- if last == "/" %}
  {%- unless entry.noindex %}
  <url><loc>{{ entry.url | absolute_url }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
  {%- endunless %}
  {%- endif %}
{%- endfor %}
</urlset>
